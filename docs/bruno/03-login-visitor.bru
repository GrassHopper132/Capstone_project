meta {
  name: 03 Sign in as that visitor
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{visitorEmail}}",
    "password": "{{visitorPassword}}"
  }
}

vars:post-response {
  visitorToken: res.body.token
}

assert {
  res.status: eq 200
  res.body.role: eq VISITOR
}
