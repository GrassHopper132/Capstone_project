meta {
  name: 07 Update artifact
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/v1/artifacts/{{createdId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accessionNumber": "2026.1.1",
    "title": "Bruno test vessel (updated)",
    "description": "Status moved to restoration.",
    "origin": "Unknown",
    "status": "IN_RESTORATION",
    "conditionGrade": "FAIR",
    "collectionId": 1,
    "locationId": 1
  }
}

assert {
  res.status: eq 200
}