meta {
  name: 01 Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "fullName": "Carlos Rhymer",
    "role": "ADMIN"
  }
}

assert {
  res.status: lt 300
}