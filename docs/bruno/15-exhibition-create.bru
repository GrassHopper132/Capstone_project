meta {
  name: 15 Schedule a show opening today
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/exhibitions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Bruno Verification Show",
    "gallery": "Gallery 9",
    "startDate": "2026-01-01",
    "endDate": "2027-12-31"
  }
}

vars:post-response {
  createdExhibitionId: res.body.id
}

assert {
  res.status: eq 201
  res.body.phase: eq CURRENT
}
