meta {
  name: 01 Sign in as administrator
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

vars:post-response {
  adminToken: res.body.token
}

assert {
  res.status: eq 200
  res.body.token: isDefined
  res.body.role: eq ADMIN
}
