meta {
  name: 29 Duplicate accession number is 409
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/v1/artifacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accessionNumber": "1994.22.7",
    "title": "Duplicate accession probe",
    "material": "Terracotta",
    "description": "Should be refused by the uniqueness rule.",
    "collectionId": 1,
    "locationId": 1
  }
}

assert {
  res.status: eq 409
}
