meta {
  name: 11 Edit that artifact
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/v1/artifacts/{{createdArtifactId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accessionNumber": "2026.9.1",
    "title": "Bruno test vessel, re-catalogued",
    "originCulture": "Unknown",
    "datePeriod": "Undated",
    "material": "Terracotta",
    "description": "Title corrected.",
    "collectionId": 1,
    "locationId": 1,
    "acquiredOn": "2026-01-15"
  }
}

assert {
  res.status: eq 200
}
