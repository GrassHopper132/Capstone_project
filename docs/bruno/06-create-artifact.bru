meta {
  name: 06 Create artifact
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/artifacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accessionNumber": "2026.1.1",
    "title": "Bruno test vessel",
    "description": "Created from Bruno during route verification.",
    "origin": "Unknown",
    "status": "STORED",
    "conditionGrade": "GOOD",
    "collectionId": 1,
    "locationId": 1
  }
}

vars:post-response {
  createdId: res.body.id
}

assert {
  res.status: eq 201
}